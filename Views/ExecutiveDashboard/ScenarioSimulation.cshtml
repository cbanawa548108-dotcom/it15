@using CRLFruitstandESS.Models.ViewModels
@using CRLFruitstandESS.Models.Executive
@using CRLFruitstandESS.Services
@model ScenarioSimulationViewModel
@{
    ViewData["Title"] = "Scenario Simulation";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@section Styles {
    <style>
        .page-content { background: #0f172a !important; min-height: 100vh; }

        .scenario-header {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            border: 1px solid #334155;
            padding: 2.5rem 2rem;
            border-radius: 14px;
            color: white;
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
        }
        .scenario-header::before {
            content: '';
            position: absolute;
            top: -60px; right: -60px;
            width: 300px; height: 300px;
            background: radial-gradient(circle, rgba(59,130,246,0.12) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }
        .scenario-header > div { position: relative; z-index: 1; }

        .dark-card {
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 14px;
            padding: 1.75rem;
            margin-bottom: 1.5rem;
            transition: all 0.3s ease;
        }

        .section-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: #f1f5f9;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin: 0 0 1.5rem 0;
        }

        .form-label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 600;
            color: #94a3b8;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }
        .dark-input {
            width: 100%;
            padding: 0.875rem 1rem;
            background: #0f172a;
            border: 1px solid #334155;
            border-radius: 8px;
            color: #f1f5f9;
            font-size: 0.95rem;
            box-sizing: border-box;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
            outline: none;
        }
        .dark-input:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,0.15); }
        .dark-input::placeholder { color: #475569; }
        .input-display {
            width: 100%;
            padding: 0.875rem 1rem;
            background: #0a1020;
            border: 1px solid #1e293b;
            border-radius: 8px;
            color: #64748b;
            font-size: 0.95rem;
            font-weight: 600;
            box-sizing: border-box;
        }
        .form-hint { margin: 0.4rem 0 0; font-size: 0.78rem; color: #475569; }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1.25rem;
            margin-bottom: 1.5rem;
        }

        .btn-run {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.875rem 2rem;
            background: #3b82f6;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 0.95rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
            outline: none;
        }
        .btn-run:hover  { background: #2563eb; transform: translateY(-2px); box-shadow: 0 6px 20px rgba(59,130,246,0.4); }
        .btn-run:active { background: #1d4ed8; transform: scale(0.98); box-shadow: none; }
        .btn-run:focus-visible { box-shadow: 0 0 0 3px rgba(59,130,246,0.5); }

        .btn-save {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.875rem 2rem;
            background: #10b981;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 0.95rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
            outline: none;
        }
        .btn-save:hover  { background: #059669; transform: translateY(-2px); box-shadow: 0 6px 20px rgba(16,185,129,0.4); }
        .btn-save:active { background: #047857; transform: scale(0.98); box-shadow: none; }
        .btn-save:focus-visible { box-shadow: 0 0 0 3px rgba(16,185,129,0.5); }

        /* Results summary */
        .results-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 1.25rem;
            margin-bottom: 1.5rem;
        }
        .result-tile {
            background: #0f172a;
            border: 1px solid #334155;
            border-radius: 10px;
            padding: 1.25rem;
            transition: border-color 0.2s ease;
        }
        .result-tile:hover { border-color: #475569; }
        .result-tile .r-label { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #64748b; margin-bottom: 0.6rem; }
        .result-tile .r-value { font-size: 1.6rem; font-weight: 800; color: #f1f5f9; line-height: 1; }

        /* Table */
        .dark-table-wrap { overflow-x: auto; border-radius: 10px; border: 1px solid #334155; }
        .dark-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
        .dark-table thead tr { background: #0f172a; }
        .dark-table thead th { padding: 1rem 1.25rem; text-align: left; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #64748b; border-bottom: 1px solid #334155; white-space: nowrap; }
        .dark-table tbody tr { border-bottom: 1px solid #1e293b; transition: background 0.2s ease; }
        .dark-table tbody tr:hover { background: #1e293b; }
        .dark-table tbody td { padding: 0.875rem 1.25rem; color: #cbd5e1; }
        .dark-table tbody tr.loss td { color: #94a3b8; }
        .dark-table .positive { color: #34d399; font-weight: 700; }
        .dark-table .negative { color: #fca5a5; font-weight: 700; }

        /* Chart */
        .chart-wrap {
            background: #0f172a;
            border: 1px solid #334155;
            border-radius: 10px;
            padding: 1.5rem;
        }

        /* Sensitivity */
        .sensitivity-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.25rem;
            margin-bottom: 1.25rem;
        }
        .sens-card {
            background: #0f172a;
            border: 1px solid #334155;
            border-radius: 10px;
            padding: 1.25rem;
            transition: border-color 0.2s ease;
        }
        .sens-card:hover { border-color: #475569; }
        .sens-card h5 { margin: 0 0 0.75rem; color: #f1f5f9; font-size: 0.9rem; font-weight: 700; }
        .sens-value { font-size: 1.4rem; font-weight: 800; color: #f1f5f9; margin-bottom: 0.25rem; }
        .sens-unit  { font-size: 0.78rem; color: #64748b; margin-bottom: 0.75rem; }
        .sens-badge {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 700;
        }
        .sens-badge.high   { background: rgba(239,68,68,0.15);  color: #fca5a5; border: 1px solid rgba(239,68,68,0.3); }
        .sens-badge.medium { background: rgba(245,158,11,0.15); color: #fcd34d; border: 1px solid rgba(245,158,11,0.3); }

        /* Saved scenarios */
        .scenarios-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 1.25rem;
        }
        .scenario-card {
            background: #0f172a;
            border: 1px solid #334155;
            border-radius: 10px;
            padding: 1.25rem;
            border-left: 3px solid #3b82f6;
            transition: all 0.2s ease;
        }
        .scenario-card:hover { border-color: #3b82f6; box-shadow: 0 4px 16px rgba(59,130,246,0.15); transform: translateY(-2px); }
        .scenario-card h5 { margin: 0 0 0.5rem; color: #f1f5f9; font-size: 0.95rem; font-weight: 700; }
        .scenario-card .s-desc { color: #64748b; font-size: 0.85rem; margin: 0 0 0.75rem; line-height: 1.5; }
        .scenario-card .s-params { display: flex; flex-direction: column; gap: 0.3rem; margin-bottom: 0.75rem; }
        .scenario-card .s-params small { color: #94a3b8; font-size: 0.8rem; }
        .scenario-card .s-date { margin: 0; font-size: 0.75rem; color: #475569; border-top: 1px solid #1e293b; padding-top: 0.75rem; }
    </style>
}

<!-- HEADER -->
<div class="scenario-header">
    <div>
        <span style="font-size:0.72rem;font-weight:800;text-transform:uppercase;letter-spacing:0.12em;color:#3b82f6;display:block;margin-bottom:0.5rem;">Pagsusuri ng "Paano Kung"</span>
        <h1 style="font-size:2.25rem;font-weight:800;margin:0 0 0.5rem;color:#f1f5f9;">Scenario Simulation</h1>
        <p style="margin:0;font-size:0.95rem;color:#94a3b8;">Subukan ang iba't ibang estratehiya sa negosyo at tingnan ang inaasahang epekto sa pananalapi</p>
    </div>
</div>

<!-- HOW IT WORKS — Professor explanation -->
<div class="dark-card" style="border-left:4px solid #3b82f6;">
    <p class="section-title" style="margin-bottom:1rem;">
        <i class="bi bi-mortarboard-fill" style="color:#3b82f6;font-size:1.2rem;"></i>
        Paano Kinakalkula ang Scenario Simulation
    </p>

    <p style="color:#94a3b8;font-size:0.875rem;margin:0 0 1.25rem;line-height:1.7;">
        Gumagamit ang module na ito ng <strong style="color:#f1f5f9;">Compound Growth Financial Modeling</strong> — isang karaniwang pamamaraan sa pagtataya ng negosyo.
        Magbibigay ka ng panimulang halaga at mga pagpapalagay sa paglago, at ang sistema ay magpapakita ng inaasahang resulta bawat buwan gamit ang mga formula sa ibaba.
    </p>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1rem;margin-bottom:1.25rem;">

        <div style="background:#0d1526;border:1px solid #1e293b;border-radius:10px;padding:1.1rem;">
            <div style="font-size:0.7rem;font-weight:800;text-transform:uppercase;letter-spacing:0.1em;color:#3b82f6;margin-bottom:0.5rem;">① Kita Bawat Buwan (Revenue)</div>
            <div style="font-family:monospace;font-size:0.9rem;color:#f1f5f9;background:#060d1a;padding:0.6rem 0.875rem;border-radius:6px;margin-bottom:0.5rem;">
                R(n) = Baseline × (1 + g)^(n−1)
            </div>
            <p style="font-size:0.78rem;color:#64748b;margin:0;line-height:1.6;">
                Ang <strong style="color:#94a3b8;">g</strong> ay ang buwanang rate ng paglago ng kita (hal. 5% = 0.05) at ang <strong style="color:#94a3b8;">n</strong> ay ang bilang ng buwan.
                Ito ay compound growth — ang bawat buwan ay nagsisimula sa resulta ng nakaraang buwan, hindi sa orihinal na halaga.
                <br/><span style="color:#475569;font-style:italic;">Halimbawa: Kung ₱100,000 ang baseline at 5% ang paglago, sa ika-2 buwan ay ₱105,000, sa ika-3 buwan ay ₱110,250, at patuloy na lumalaki.</span>
            </p>
        </div>

        <div style="background:#0d1526;border:1px solid #1e293b;border-radius:10px;padding:1.1rem;">
            <div style="font-size:0.7rem;font-weight:800;text-transform:uppercase;letter-spacing:0.1em;color:#ef4444;margin-bottom:0.5rem;">② Gastos sa Produkto (COGS)</div>
            <div style="font-family:monospace;font-size:0.9rem;color:#f1f5f9;background:#060d1a;padding:0.6rem 0.875rem;border-radius:6px;margin-bottom:0.5rem;">
                COGS(n) = R(n) × COGS%
            </div>
            <p style="font-size:0.78rem;color:#64748b;margin:0;line-height:1.6;">
                Ang COGS (Cost of Goods Sold) ay ang direktang gastos sa pagbili ng prutas at ang halaga ng nasayang na produkto (spoilage).
                Batay sa 5-taong datos ng CRL Fruitstand, ang benchmark ay <strong style="color:#94a3b8;">~30.5%</strong> ng kita.
                <br/><span style="color:#475569;font-style:italic;">Halimbawa: Kung ₱100,000 ang kita at 30% ang COGS, ang gastos sa produkto ay ₱30,000.</span>
            </p>
        </div>

        <div style="background:#0d1526;border:1px solid #1e293b;border-radius:10px;padding:1.1rem;">
            <div style="font-size:0.7rem;font-weight:800;text-transform:uppercase;letter-spacing:0.1em;color:#f59e0b;margin-bottom:0.5rem;">③ Gastos sa Operasyon (OpEx)</div>
            <div style="font-family:monospace;font-size:0.9rem;color:#f1f5f9;background:#060d1a;padding:0.6rem 0.875rem;border-radius:6px;margin-bottom:0.5rem;">
                OpEx(n) = Baseline Expenses × (1 + e)^(n−1)
            </div>
            <p style="font-size:0.78rem;color:#64748b;margin:0;line-height:1.6;">
                Ang <strong style="color:#94a3b8;">e</strong> ay ang buwanang rate ng paglago ng gastos. Kasama dito ang sahod ng mga empleyado, kuryente, tubig, transportasyon, at iba pang regular na gastos.
                <br/><span style="color:#475569;font-style:italic;">Halimbawa: Kung ₱50,000 ang gastos ngayon at 2% ang paglago, sa susunod na buwan ay ₱51,000.</span>
            </p>
        </div>

        <div style="background:#0d1526;border:1px solid #1e293b;border-radius:10px;padding:1.1rem;">
            <div style="font-size:0.7rem;font-weight:800;text-transform:uppercase;letter-spacing:0.1em;color:#22c55e;margin-bottom:0.5rem;">④ Netong Kita (Net Profit)</div>
            <div style="font-family:monospace;font-size:0.9rem;color:#f1f5f9;background:#060d1a;padding:0.6rem 0.875rem;border-radius:6px;margin-bottom:0.5rem;">
                Profit(n) = R(n) − COGS(n) − OpEx(n)
            </div>
            <p style="font-size:0.78rem;color:#64748b;margin:0;line-height:1.6;">
                Ito ang tunay na kita ng negosyo pagkatapos ibawas ang lahat ng gastos. Kung negatibo ang resulta, nangangahulugang lugi ang negosyo sa buwang iyon.
                <br/><span style="color:#475569;font-style:italic;">Halimbawa: ₱100,000 kita − ₱30,000 COGS − ₱50,000 OpEx = ₱20,000 netong kita.</span>
            </p>
        </div>

        <div style="background:#0d1526;border:1px solid #1e293b;border-radius:10px;padding:1.1rem;">
            <div style="font-size:0.7rem;font-weight:800;text-transform:uppercase;letter-spacing:0.1em;color:#a78bfa;margin-bottom:0.5rem;">⑤ Gross Margin %</div>
            <div style="font-family:monospace;font-size:0.9rem;color:#f1f5f9;background:#060d1a;padding:0.6rem 0.875rem;border-radius:6px;margin-bottom:0.5rem;">
                GM%(n) = (R(n) − COGS(n)) / R(n) × 100
            </div>
            <p style="font-size:0.78rem;color:#64748b;margin:0;line-height:1.6;">
                Ito ang porsyento ng kita na natitira pagkatapos ibawas ang gastos sa produkto, bago pa ibawas ang gastos sa operasyon. Nagpapakita kung gaano kahusay na ginagawang kita ang bawat benta.
                <br/><span style="color:#475569;font-style:italic;">Halimbawa: (₱100,000 − ₱30,000) ÷ ₱100,000 × 100 = 70% gross margin.</span>
            </p>
        </div>

        <div style="background:#0d1526;border:1px solid #1e293b;border-radius:10px;padding:1.1rem;">
            <div style="font-size:0.7rem;font-weight:800;text-transform:uppercase;letter-spacing:0.1em;color:#22d3ee;margin-bottom:0.5rem;">⑥ Return on Investment (ROI)</div>
            <div style="font-family:monospace;font-size:0.9rem;color:#f1f5f9;background:#060d1a;padding:0.6rem 0.875rem;border-radius:6px;margin-bottom:0.5rem;">
                ROI = Σ Profit / Σ OpEx × 100
            </div>
            <p style="font-size:0.78rem;color:#64748b;margin:0;line-height:1.6;">
                Ang kabuuang netong kita na hinati sa kabuuang gastos sa operasyon sa buong panahon ng simulation. Sinusukat kung magkano ang kita para sa bawat pisong ginastos.
                <br/><span style="color:#475569;font-style:italic;">Halimbawa: Kung ₱240,000 ang kabuuang kita at ₱600,000 ang kabuuang gastos, ang ROI ay 40% — ibig sabihin, bawat ₱1 na ginastos ay kumikita ng ₱0.40.</span>
            </p>
        </div>

    </div>

    <div style="background:#0d1526;border:1px solid #1e3a5f;border-radius:8px;padding:0.875rem 1rem;display:flex;align-items:flex-start;gap:0.75rem;">
        <i class="bi bi-info-circle-fill" style="color:#3b82f6;font-size:1rem;flex-shrink:0;margin-top:2px;"></i>
        <p style="margin:0;font-size:0.8rem;color:#64748b;line-height:1.6;">
            <strong style="color:#94a3b8;">Sensitivity Analysis (Pagsusuri ng Sensitibidad)</strong> — Sinusubok nito kung gaano kalaki ang pagbabago ng kita kapag ang bawat variable ay tumaas o bumaba ng ±10%.
            Ang variable na may pinakamataas na porsyento ng epekto ay ang pinaka-kritikal na salik para sa pag-optimize ng kita.
            Ginagamit nito ang parehong compound growth model na tatlong beses — isang beses na may pagtaas ng variable, isang beses na may pagbaba — at sinusukat ang pagkakaiba ng kita.
            <br/><span style="color:#475569;font-style:italic;">Sa madaling salita: Kung ang kita ay mas sensitibo sa presyo kaysa sa gastos, mas mahalaga ang pagpepresyo kaysa sa pagbabawas ng gastos para mapataas ang kita.</span>
        </p>
    </div>
</div>

<!-- SIMULATION FORM -->
<div class="dark-card">
    <p class="section-title">
        <i class="bi bi-list-ol" style="color:#10b981;font-size:1.2rem;"></i>
        Paano Gamitin ang Scenario Simulation — Hakbang sa Hakbang
    </p>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:.85rem;margin-bottom:.25rem;">
        <div style="background:#0f172a;border-radius:10px;padding:1rem 1.1rem;border-left:3px solid #3b82f6;">
            <div style="font-size:.7rem;font-weight:800;text-transform:uppercase;letter-spacing:.09em;color:#3b82f6;margin-bottom:.4rem;">Hakbang 1 — Itakda ang Baseline</div>
            <p style="font-size:.8rem;color:#94a3b8;margin:0;line-height:1.65;">
                Ilagay ang <strong style="color:#f1f5f9;">Panimulang Buwanang Kita</strong> — ito ang kasalukuyang average na kita ng negosyo bawat buwan.
                Awtomatikong kinukuha ito mula sa database, pero maaari mo itong baguhin para subukan ang ibang sitwasyon.
                <br/><span style="color:#475569;font-style:italic;">Tip: Gamitin ang aktwal na kita ng nakaraang buwan para sa mas tumpak na resulta.</span>
            </p>
        </div>
        <div style="background:#0f172a;border-radius:10px;padding:1rem 1.1rem;border-left:3px solid #f59e0b;">
            <div style="font-size:.7rem;font-weight:800;text-transform:uppercase;letter-spacing:.09em;color:#f59e0b;margin-bottom:.4rem;">Hakbang 2 — Itakda ang mga Rate ng Paglago</div>
            <p style="font-size:.8rem;color:#94a3b8;margin:0;line-height:1.65;">
                Ilagay ang <strong style="color:#f1f5f9;">% ng paglago ng kita</strong> at <strong style="color:#f1f5f9;">% ng paglago ng gastos</strong> bawat buwan.
                Halimbawa: kung inaasahan mong tataas ng 5% ang benta bawat buwan dahil sa bagong promosyon, ilagay ang 5.
                Kung negatibo ang inaasahan (pagbaba), ilagay ang negatibong numero tulad ng -3.
            </p>
        </div>
        <div style="background:#0f172a;border-radius:10px;padding:1rem 1.1rem;border-left:3px solid #ef4444;">
            <div style="font-size:.7rem;font-weight:800;text-transform:uppercase;letter-spacing:.09em;color:#ef4444;margin-bottom:.4rem;">Hakbang 3 — Itakda ang COGS %</div>
            <p style="font-size:.8rem;color:#94a3b8;margin:0;line-height:1.65;">
                Ang <strong style="color:#f1f5f9;">COGS %</strong> ay ang porsyento ng kita na ginagastos sa pagbili ng prutas at sa nasayang na produkto.
                Para sa CRL Fruitstand, ang benchmark ay 30–35%. Kung mas mababa ang COGS, mas malaki ang kita.
                <br/><span style="color:#475569;font-style:italic;">Tip: Subukan ang 25% para makita kung gaano kalaki ang magiging kita kung mabawasan ang spoilage.</span>
            </p>
        </div>
        <div style="background:#0f172a;border-radius:10px;padding:1rem 1.1rem;border-left:3px solid #8b5cf6;">
            <div style="font-size:.7rem;font-weight:800;text-transform:uppercase;letter-spacing:.09em;color:#8b5cf6;margin-bottom:.4rem;">Hakbang 4 — Piliin ang Tagal</div>
            <p style="font-size:.8rem;color:#94a3b8;margin:0;line-height:1.65;">
                Piliin kung ilang buwan ang gusto mong i-simulate. Ang <strong style="color:#f1f5f9;">12 buwan</strong> ay katumbas ng isang buong taon.
                Mas matagal ang simulation, mas makikita mo kung kailan magiging kumikita o lugi ang negosyo.
            </p>
        </div>
        <div style="background:#0f172a;border-radius:10px;padding:1rem 1.1rem;border-left:3px solid #10b981;">
            <div style="font-size:.7rem;font-weight:800;text-transform:uppercase;letter-spacing:.09em;color:#10b981;margin-bottom:.4rem;">Hakbang 5 — Patakbuhin at Basahin ang Resulta</div>
            <p style="font-size:.8rem;color:#94a3b8;margin:0;line-height:1.65;">
                I-click ang <strong style="color:#f1f5f9;">"Patakbuhin ang Simulation"</strong>. Makikita mo ang buwanang proyeksyon ng kita, gastos, at netong kita.
                Ang <strong style="color:#34d399;">berdeng numero</strong> ay kita, ang <strong style="color:#fca5a5;">pulang numero</strong> ay lugi.
                Tingnan din ang Sensitivity Analysis para malaman kung aling variable ang pinaka-mahalaga.
            </p>
        </div>
        <div style="background:#0f172a;border-radius:10px;padding:1rem 1.1rem;border-left:3px solid #22d3ee;">
            <div style="font-size:.7rem;font-weight:800;text-transform:uppercase;letter-spacing:.09em;color:#22d3ee;margin-bottom:.4rem;">Hakbang 6 — I-save ang Scenario</div>
            <p style="font-size:.8rem;color:#94a3b8;margin:0;line-height:1.65;">
                Pagkatapos ng simulation, maaari mong i-save ang scenario para ikumpara sa ibang mga plano sa hinaharap.
                Bigyan ito ng pangalan tulad ng <em style="color:#f1f5f9;">"Optimistiko — Bagong Produkto"</em> o <em style="color:#f1f5f9;">"Worst Case — Taas ng Gastos"</em>
                para madaling makilala sa ibang pagkakataon.
            </p>
        </div>
    </div>
</div>

<!-- SIMULATION FORM -->
<div class="dark-card">
    <p class="section-title">
        <i class="bi bi-sliders" style="color:#3b82f6;font-size:1.3rem;"></i> Gumawa ng Bagong Scenario
    </p>

    
    <form method="post" action="@Url.Action("SimulateScenario", "ExecutiveDashboard")">
        @Html.AntiForgeryToken()
        <div class="form-grid">
            <div>
                <label class="form-label">Panimulang Buwanang Kita (Baseline Revenue)</label>
                <input type="number" name="baselineRevenue" value="@Model.BaselineMonthlyRevenue" min="0" step="100" required class="dark-input" />
                <p class="form-hint">Default: kasalukuyang buwanang kita mula sa database. Maaaring baguhin para subukan ang ibang halaga.</p>
            </div>
            <div>
                <label class="form-label" for="revenueGrowth">Paglago ng Kita % / buwan</label>
                <input type="number" id="revenueGrowth" name="revenueGrowth" step="0.5" value="@Model.RevenueGrowthPercent" required class="dark-input" />
                <p class="form-hint">hal. 5 = lumalaki ng 5% ang kita bawat buwan (compound). Gamitin ang negatibong numero para sa pagbaba.</p>
            </div>
            <div>
                <label class="form-label" for="expenseGrowth">Paglago ng Gastos % / buwan</label>
                <input type="number" id="expenseGrowth" name="expenseGrowth" step="0.5" value="@Model.ExpenseGrowthPercent" required class="dark-input" />
                <p class="form-hint">hal. 2 = lumalaki ng 2% ang gastos bawat buwan. Kasama ang sahod, kuryente, at transportasyon.</p>
            </div>
            <div>
                <label class="form-label" for="cogsPercent">COGS % ng Kita</label>
                <input type="number" id="cogsPercent" name="cogsPercent" step="1" value="@Model.CogsPercent" min="0" max="100" required class="dark-input" />
                <p class="form-hint">Benchmark ng fruit stand: ~30–35% (spoilage + pagbili ng prutas). Mas mababa = mas mahusay.</p>
            </div>
            <div>
                <label class="form-label" for="months">Tagal ng Simulation (buwan)</label>
                <input type="number" id="months" name="months" value="@Model.SimulationMonths" min="1" max="36" required class="dark-input" />
                <p class="form-hint">1–36 buwan. 12 = buong taon na proyeksyon. 6 = kalahating taon.</p>
            </div>
        </div>
        <button type="submit" class="btn-run">
            <i class="bi bi-play-circle-fill"></i> Patakbuhin ang Simulation
        </button>
    </form>
</div>

<!-- RESULTS -->
@if (Model.SimulationResult != null)
{
    <div class="dark-card">
        <p class="section-title">
            <i class="bi bi-bar-chart-line" style="color:#10b981;font-size:1.3rem;"></i> Results: @Model.SimulationResult.ScenarioName
        </p>
        <div class="results-grid">
            <div class="result-tile" style="border-top:3px solid #3b82f6;">
                <div class="r-label">Kabuuang Kita</div>
                <div class="r-value">₱@Model.SimulationResult.TotalProjectedRevenue.ToString("N0")</div>
            </div>
            <div class="result-tile" style="border-top:3px solid #10b981;">
                <div class="r-label">Kabuuang Kita (Profit)</div>
                <div class="r-value" style="color:@(Model.SimulationResult.TotalProjectedProfit >= 0 ? "#34d399" : "#fca5a5");">₱@Model.SimulationResult.TotalProjectedProfit.ToString("N0")</div>
            </div>
            <div class="result-tile" style="border-top:3px solid #f59e0b;">
                <div class="r-label">Avg. Margin</div>
                <div class="r-value">@Model.SimulationResult.AverageMargin.ToString("F1")%</div>
            </div>
            <div class="result-tile" style="border-top:3px solid #8b5cf6;">
                <div class="r-label">ROI</div>
                <div class="r-value">@Model.SimulationResult.ROI.ToString("F1")%</div>
            </div>
        </div>

        <!-- Monthly Projections Table -->
        <p class="section-title" style="margin-top:0.5rem;">
            <i class="bi bi-table" style="color:#8b5cf6;font-size:1.2rem;"></i> Buwanang Proyeksyon
            <span style="margin-left:auto;font-size:0.72rem;font-weight:400;color:#475569;">Gross Margin % = (Kita − COGS) / Kita × 100</span>
        </p>
        <div class="dark-table-wrap">
            <table class="dark-table">
                <thead>
                    <tr>
                        <th>Buwan</th>
                        <th>Kita</th>
                        <th>COGS (@Model.CogsPercent%)</th>
                        <th>Gastos sa Operasyon</th>
                        <th>Netong Kita</th>
                        <th>Gross Margin %</th>
                        <th>Kabuuang Kita</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var proj in Model.SimulationResult.Projections)
                    {
                        <tr class="@(proj.ProjectedProfit < 0 ? "loss" : "")">
                            <td style="color:#94a3b8;font-weight:600;">Buwan @proj.Month</td>
                            <td>₱@proj.ProjectedRevenue.ToString("N0")</td>
                            <td style="color:#fca5a5;">₱@proj.ProjectedCOGS.ToString("N0")</td>
                            <td style="color:#fcd34d;">₱@proj.ProjectedOpEx.ToString("N0")</td>
                            <td class="@(proj.ProjectedProfit < 0 ? "negative" : "positive")">₱@proj.ProjectedProfit.ToString("N0")</td>
                            <td style="color:#94a3b8;">@proj.ProfitMargin.ToString("F1")%</td>
                            <td><strong style="color:#f1f5f9;">₱@proj.CumulativeProfit.ToString("N0")</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Chart -->
    <div class="dark-card">
        <p class="section-title">
            <i class="bi bi-graph-up" style="color:#3b82f6;font-size:1.3rem;"></i> Tsart ng Proyeksyon ng Kita
        </p>
        <div class="chart-wrap">
            <canvas id="profitChart"></canvas>
        </div>
    </div>

    <!-- Sensitivity Analysis -->
    @if (Model.SensitivityAnalysis.Any())
    {
        <div class="dark-card">
            <p class="section-title">
                <i class="bi bi-activity" style="color:#f59e0b;font-size:1.3rem;"></i> Sensitivity Analysis — Pagsusuri ng Sensitibidad
            </p>
            <p style="color:#64748b;font-size:0.875rem;margin:-0.5rem 0 1.25rem;">Gaano kalaki ang pagbabago ng kita kapag nagbago ang mga pangunahing variable?</p>
            <div class="sensitivity-grid">
                @foreach (var sens in Model.SensitivityAnalysis)
                {
                    <div class="sens-card">
                        <h5>@sens.Variable</h5>
                        <div class="sens-value">₱@sens.ImpactOnProfit.ToString("N0")</div>
                        <div class="sens-unit">per ±10% change</div>
                        <span class="sens-badge @(Math.Abs(sens.ImpactPercentage) > 20 ? "high" : "medium")">
                            @Math.Abs(sens.ImpactPercentage).ToString("F1")% epekto
                        </span>
                    </div>
                }
            </div>
            <div style="display:flex;align-items:start;gap:0.75rem;padding:1rem;background:#0f172a;border:1px solid #334155;border-radius:8px;border-left:3px solid #f59e0b;">
                <i class="bi bi-lightbulb-fill" style="color:#f59e0b;font-size:1.1rem;flex-shrink:0;margin-top:2px;"></i>
                <p style="margin:0;color:#94a3b8;font-size:0.875rem;line-height:1.6;">Ang variable na may pinakamataas na porsyento ng epekto ay ang pinaka-kritikal na salik para sa pag-optimize ng kita. Doon dapat nakatuon ang iyong pansin sa pagpapabuti ng negosyo.</p>
            </div>
        </div>
    }

    <!-- Save Scenario -->
    <div class="dark-card">
        <p class="section-title">
            <i class="bi bi-bookmark-plus" style="color:#10b981;font-size:1.3rem;"></i> I-save ang Scenario na Ito
        </p>
        <form method="post" action="@Url.Action("SaveScenario", "ExecutiveDashboard")">
            @Html.AntiForgeryToken()
            <input type="hidden" name="baselineRevenue" value="@Model.BaselineMonthlyRevenue" />
            <input type="hidden" name="revenueGrowth"   value="@Model.RevenueGrowthPercent" />
            <input type="hidden" name="expenseGrowth"   value="@Model.ExpenseGrowthPercent" />
            <input type="hidden" name="cogsPercent"     value="@Model.CogsPercent" />
            <input type="hidden" name="months"          value="@Model.SimulationMonths" />
            <div class="form-grid" style="margin-bottom:1.5rem;">
                <div>
                    <label class="form-label" for="scenarioName">Pangalan ng Scenario</label>
                    <input type="text" id="scenarioName" name="scenarioName" placeholder="hal. Optimistikong Paglago, Worst Case..." required class="dark-input" />
                </div>
                <div>
                    <label class="form-label" for="description">Paglalarawan</label>
                    <textarea id="description" name="description" placeholder="Opsyonal na mga tala tungkol sa scenario na ito..." rows="3" class="dark-input" style="resize:vertical;"></textarea>
                </div>
            </div>
            <button type="submit" class="btn-save">
                <i class="bi bi-save-fill"></i> I-save ang Scenario
            </button>
        </form>
    </div>
}

<!-- SAVED SCENARIOS -->
@if (Model.SavedScenarios.Any())
{
    <div class="dark-card">
        <p class="section-title">
            <i class="bi bi-collection" style="color:#8b5cf6;font-size:1.3rem;"></i> Mga Naka-save na Scenario
        </p>
        <div class="scenarios-grid">
            @foreach (var scenario in Model.SavedScenarios.OrderByDescending(s => s.CreatedAt).Take(6))
            {
                <div class="scenario-card">
                    <h5>@scenario.ScenarioName</h5>
                    @if (!string.IsNullOrEmpty(scenario.Description))
                    {
                        <p class="s-desc">@scenario.Description</p>
                    }
                    <div class="s-params">
                        <small><span style="color:#3b82f6;">↑</span> Paglago ng Kita: <strong style="color:#f1f5f9;">@scenario.RevenueGrowthPercent%</strong></small>
                        <small><span style="color:#f59e0b;">↑</span> Paglago ng Gastos: <strong style="color:#f1f5f9;">@scenario.ExpenseIncreasePercent%</strong></small>
                        <small><span style="color:#94a3b8;">⏱</span> Tagal: <strong style="color:#f1f5f9;">@scenario.SimulationMonths buwan</strong></small>
                    </div>
                    <p class="s-date">@scenario.CreatedAt.ToString("MMM dd, yyyy")</p>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        @if (Model.SimulationResult != null && Model.SimulationResult.Projections.Any())
        {
            <text>
            const projections = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.SimulationResult.Projections.Select(p => new {
                    month = p.Month,
                    profit = p.ProjectedProfit,
                    cumulative = p.CumulativeProfit
                }).ToList()
            ));

            const ctx = document.getElementById('profitChart').getContext('2d');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: projections.map(p => 'M' + p.month),
                    datasets: [
                        {
                            label: 'Buwanang Kita',
                            data: projections.map(p => p.profit),
                            borderColor: '#3b82f6',
                            backgroundColor: 'rgba(59,130,246,0.08)',
                            borderWidth: 2,
                            pointBackgroundColor: '#3b82f6',
                            pointRadius: 4,
                            tension: 0.4,
                            fill: true
                        },
                        {
                            label: 'Kabuuang Kita (Cumulative)',
                            data: projections.map(p => p.cumulative),
                            borderColor: '#10b981',
                            backgroundColor: 'rgba(16,185,129,0.08)',
                            borderWidth: 2,
                            pointBackgroundColor: '#10b981',
                            pointRadius: 4,
                            tension: 0.4,
                            yAxisID: 'y1',
                            fill: true
                        }
                    ]
                },
                options: {
                    responsive: true,
                    interaction: { mode: 'index', intersect: false },
                    plugins: {
                        legend: {
                            labels: { color: '#94a3b8', usePointStyle: true, padding: 20 }
                        },
                        tooltip: {
                            backgroundColor: '#1e293b',
                            borderColor: '#334155',
                            borderWidth: 1,
                            titleColor: '#f1f5f9',
                            bodyColor: '#94a3b8',
                            callbacks: {
                                label: ctx => ctx.dataset.label + ': ₱' + ctx.parsed.y.toLocaleString()
                            }
                        }
                    },
                    scales: {
                        x:  { ticks: { color: '#64748b' }, grid: { color: '#1e293b' } },
                        y:  { position: 'left',  ticks: { color: '#64748b', callback: v => '₱' + v.toLocaleString() }, grid: { color: '#1e293b' } },
                        y1: { position: 'right', ticks: { color: '#64748b', callback: v => '₱' + v.toLocaleString() }, grid: { drawOnChartArea: false } }
                    }
                }
            });
            </text>
        }
    </script>
}

