@model IEnumerable<CRLFruitstandESS.Models.ViewModels.SupplierPaymentViewModel>
@{
    ViewData["Title"] = "Supplier Payments";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="payments-page">
    <div class="page-header">
        <div class="header-left">
            <span class="breadcrumb">Finance</span>
            <h1>Payment History</h1>
        </div>
        <a href="/Inventory/PaySupplier" class="btn-add">
            <i class="bi bi-cash-stack"></i> New Payment
        </a>
    </div>

    <div class="table-card">
        <div class="table-header">
            <h3>Recent Payments</h3>
        </div>
        
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Supplier</th>
                        <th>Amount</th>
                        <th>Method</th>
                        <th>Reference</th>
                        <th>Processed By</th>
                        <th>Status</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in Model)
                    {
                        <tr>
                            <td>@payment.PaymentDate.ToString("MMM dd, yyyy HH:mm")</td>
                            <td><strong>@payment.SupplierName</strong></td>
                            <td class="amount">₱@payment.Amount.ToString("N2")</td>
                            <td>
                                @{
                                    var mIcon = payment.PaymentMethod?.ToLower() switch {
                                        "gcash"   => "📱",
                                        "paymaya" => "💳",
                                        "maya"    => "💳",
                                        "cash"    => "💵",
                                        "check"   => "🏦",
                                        "bank transfer" => "🏦",
                                        "pending" => "⏳",
                                        _         => "💰"
                                    };
                                }
                                @mIcon @payment.PaymentMethod
                            </td>
                            <td style="font-family:monospace;font-size:.82rem;color:#94a3b8">@payment.ReferenceNumber</td>
                            <td>
                                @if (!string.IsNullOrEmpty(payment.PaidBy))
                                {
                                    var initial = payment.PaidBy.Length > 0 ? payment.PaidBy[0].ToString().ToUpper() : "?";
                                    var isSystem = payment.PaidBy.Equals("System", StringComparison.OrdinalIgnoreCase);
                                    <div style="display:flex;align-items:center;gap:.5rem;">
                                        <div style="width:28px;height:28px;border-radius:50%;background:@(isSystem ? "rgba(100,116,139,.2)" : "rgba(59,130,246,.2)");color:@(isSystem ? "#94a3b8" : "#60a5fa");display:flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:800;flex-shrink:0;">
                                            @(isSystem ? "⚙" : initial)
                                        </div>
                                        <div>
                                            <div style="font-size:.82rem;font-weight:600;color:#f1f5f9;">@payment.PaidBy</div>
                                            <div style="font-size:.68rem;color:#475569;">@(isSystem ? "Auto-generated" : "Staff")</div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <span style="color:#475569;font-size:.78rem;">—</span>
                                }
                            </td>
                            <td>
                                @if (payment.IsPending)
                                {
                                    <span style="background:rgba(245,158,11,.15);color:#fbbf24;border:1px solid rgba(245,158,11,.3);border-radius:999px;padding:.2rem .6rem;font-size:.68rem;font-weight:700;">⏳ PENDING</span>
                                }
                                else
                                {
                                    <span style="background:rgba(16,185,129,.15);color:#34d399;border:1px solid rgba(16,185,129,.3);border-radius:999px;padding:.2rem .6rem;font-size:.68rem;font-weight:700;">✓ PAID</span>
                                }
                            </td>
                            <td style="color:#64748b;font-size:.8rem;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@payment.Notes">@payment.Notes</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Styles {
<style>
    .payments-page { padding: 2rem; max-width: 1400px; margin: 0 auto; }
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
    .header-left .breadcrumb { color: #64b5f6; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.5rem; }
    .header-left h1 { color: #fff; font-size: 1.75rem; font-weight: 700; margin: 0; }
    .btn-add { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; background: linear-gradient(135deg, #22c55e, #16a34a); color: #fff; border-radius: 10px; text-decoration: none; font-weight: 600; }
    .table-card { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; overflow: hidden; }
    .table-header { padding: 1.25rem 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.08); }
    .table-header h3 { color: #fff; font-size: 1.1rem; font-weight: 600; margin: 0; }
    .table-container { overflow-x: auto; }
    .data-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
    .data-table th { text-align: left; padding: 1rem 1.5rem; color: #94a3b8; font-weight: 600; font-size: 0.75rem; text-transform: uppercase; background: rgba(255,255,255,0.02); border-bottom: 1px solid rgba(255,255,255,0.08); }
    .data-table td { padding: 1rem 1.5rem; color: #cbd5e1; border-bottom: 1px solid rgba(255,255,255,0.04); }
    .data-table tr:hover td { background: rgba(255,255,255,0.02); }
    .amount { color: #22c55e; font-weight: 700; }
</style>
}