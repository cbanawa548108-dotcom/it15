// ── Entrance animation
document.querySelectorAll('.chart-panel, .stat-cell').forEach((el, i) => {
    el.style.opacity = '0';
    el.style.transform = 'translateY(8px)';
    el.style.transition = `opacity .5s ease ${i * 0.045}s, transform .5s ease ${i * 0.045}s`;
    requestAnimationFrame(() => requestAnimationFrame(() => {
        el.style.opacity = '1';
        el.style.transform = 'translateY(0)';
    }));
});

// ── Persist selected period in localStorage
(function() {
    var key = 'analytics_period';
    var pills = document.querySelectorAll('.period-pill');
    var saved = localStorage.getItem(key);
    var currentPeriod = '@Model.Period';
    if (saved && saved !== currentPeriod) {
        var url = new URL(window.location.href);
        if (!url.searchParams.has('period')) {
            url.searchParams.set('period', saved);
            window.location.replace(url.toString());
        }
    }
    pills.forEach(function(pill) {
        pill.addEventListener('click', function() {
            var href = pill.getAttribute('href') || '';
            var match = href.match(/period=([^&]+)/);
            if (match) localStorage.setItem(key, match[1]);
        });
    });
    if (currentPeriod) localStorage.setItem(key, currentPeriod);
})();
