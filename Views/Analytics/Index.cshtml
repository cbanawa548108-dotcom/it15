// ── HEAT MAP
fetch(`/Analytics/HeatMapData?period=${PERIOD}`).then(r=>r.json()).then(rows=>{
    const days=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
    const maxVal=Math.max(...rows.map(r=>Number(r.value)),1);
    const datasets=days.map((d,di)=>({
        label:d,
        data:rows.filter(r=>r.day===d).map(r=>({x:r.hour,y:di,r:Math.max(5,Math.sqrt(Number(r.value)/maxVal)*20)})),
        backgroundColor:`hsla(${di*50},80%,65%,.7)`
    }));
    new Chart(document.getElementById('heatChart'),{
        type:'bubble', data:{datasets},
        options:{responsive:true,
            plugins:{legend:{display:false},
                tooltip:{backgroundColor:'#1e293b',borderColor:'rgba(129,140,248,.6)',borderWidth:2,titleColor:'#ffffff',bodyColor:'#e2e8f0',padding:14,
                    callbacks:{label:c=>`${days[c.parsed.y]} ${c.parsed.x}:00 — ₱${(rows.find(r=>r.day===days[c.parsed.y]&&r.hour===c.parsed.x)?.value||0).toLocaleString()}`}}},
            scales:{
                x:{min:0,max:23,ticks:{color:'#94a3b8',font:{size:13},callback:v=>v+':00',stepSize:3},grid:{color:GRID}},
                y:{min:-0.5,max:6.5,ticks:{color:'#f1f5f9',font:{size:13,weight:'600'},callback:v=>days[v]||''},grid:{color:GRID}}
            }}
    });
});

