@using CRLFruitstandESS.Models.ViewModels
@using System.Text.Json
@model AnalyticsViewModel
@{
    ViewData["Title"] = "Analytics";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var jo = new JsonSerializerOptions();
    string J(object o) => JsonSerializer.Serialize(o, jo);
}

@section Styles {
<script>document.body.classList.add('analytics-page');</script>
<style>
/* ═══════════════════════════════════════════════════
   ANALYTICS — HIGH-VISIBILITY REDESIGN
═══════════════════════════════════════════════════ */

.page-content {
    background: #0d1526 !important;
    min-height: 100vh;
}
.an-wrap { position: relative; z-index: 1; padding: 0 1.5rem 3rem; }

/* ── HERO HEADER ── */
.an-hero {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 2.5rem;
    padding: 3rem 0 2.5rem;
    margin-bottom: 3rem;
    border-bottom: 2px solid rgba(255,255,255,.3);
}
.an-hero-eyebrow {
    font-size: .82rem; font-weight: 900; letter-spacing: .32em;
    text-transform: uppercase;
    color: #0ea5e9;
    margin-bottom: 1rem;
    text-shadow: 0 0 10px rgba(14,165,233,.4);
}
.an-hero h1 {
    font-size: 4.2rem; font-weight: 900; color: #ffffff;
    margin: 0 0 .6rem; letter-spacing: -.025em; line-height: 1;
    text-shadow: 0 4px 30px rgba(99,102,241,.5);
}
.an-hero p { margin: 0; color: #cbd5e1; font-size: 1rem; font-weight: 500; }

/* Period pills */
.period-pills { display: flex; gap: .8rem; }
.period-pill {
    padding: .75rem 1.75rem; border-radius: 999px;
    font-size: .92rem; font-weight: 800;
    border: 2px solid rgba(255,255,255,.4);
    background: rgba(255,255,255,.1);
    color: #e2e8f0; text-decoration: none;
    transition: all .3s cubic-bezier(.34, 1.56, .64, 1);
    letter-spacing: .08em;
    box-shadow: 0 4px 12px rgba(0,0,0,.3);
}
.period-pill:hover { 
    border-color: #60a5fa; 
    color: #bfdbfe; 
    background: rgba(59,130,246,.3); 
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(59,130,246,.3);
}
.period-pill.active {
    background: linear-gradient(135deg, #3b82f6, #6366f1);
    border-color: rgba(255,255,255,.6);
    color: #ffffff;
    box-shadow: 0 0 30px rgba(59,130,246,.8), 0 8px 20px rgba(0,0,0,.5), inset 0 1px 10px rgba(255,255,255,.3);
    text-shadow: 0 0 8px rgba(59,130,246,.6);
}

/* ── STAT STRIP ── */
.stat-strip {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 6px;
    background: rgba(255,255,255,.18);
    border-radius: 24px;
    overflow: hidden;
    margin-bottom: 3.5rem;
    border: 3px solid rgba(255,255,255,.4);
    box-shadow: 0 20px 60px rgba(0,0,0,.7), 0 0 60px rgba(59,130,246,.35), inset 0 1px 20px rgba(255,255,255,.08);
}
.stat-cell {
    background: linear-gradient(135deg, #162844 0%, #1e3a52 50%, #243558 100%);
    padding: 2.75rem 2rem;
    position: relative;
    overflow: hidden;
    transition: all .4s cubic-bezier(.34, 1.56, .64, 1);
    box-shadow: inset 0 1px 20px rgba(255,255,255,.15), 0 8px 24px rgba(0,0,0,.4);
}
.stat-cell:hover { 
    background: linear-gradient(135deg, #1e3a52 0%, #2a4570 50%, #304a70 100%);
    box-shadow: inset 0 1px 20px rgba(255,255,255,.2), 0 16px 48px rgba(0,0,0,.7);
    transform: translateY(-5px);
}

/* Glowing top accent bar — thicker */
.stat-cell::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 7px;
}
.stat-cell.c-blue::before   { background: linear-gradient(90deg,#3b82f6,#818cf8); box-shadow: 0 0 15px #3b82f6; }
.stat-cell.c-red::before    { background: linear-gradient(90deg,#ef4444,#f87171); box-shadow: 0 0 15px #ef4444; }
.stat-cell.c-green::before  { background: linear-gradient(90deg,#10b981,#34d399); box-shadow: 0 0 15px #10b981; }
.stat-cell.c-teal::before   { background: linear-gradient(90deg,#06b6d4,#22d3ee); box-shadow: 0 0 15px #06b6d4; }
.stat-cell.c-amber::before  { background: linear-gradient(90deg,#f59e0b,#fbbf24); box-shadow: 0 0 15px #f59e0b; }
.stat-cell.c-purple::before { background: linear-gradient(90deg,#8b5cf6,#a78bfa); box-shadow: 0 0 15px #8b5cf6; }

/* Subtle glow bg */
.stat-cell.c-blue::after   { content:''; position:absolute; inset:0; background:radial-gradient(ellipse at 50% 0%,rgba(59,130,246,.15) 0%,transparent 70%); pointer-events:none; }
.stat-cell.c-red::after    { content:''; position:absolute; inset:0; background:radial-gradient(ellipse at 50% 0%,rgba(239,68,68,.13) 0%,transparent 70%); pointer-events:none; }
.stat-cell.c-green::after  { content:''; position:absolute; inset:0; background:radial-gradient(ellipse at 50% 0%,rgba(16,185,129,.13) 0%,transparent 70%); pointer-events:none; }
.stat-cell.c-teal::after   { content:''; position:absolute; inset:0; background:radial-gradient(ellipse at 50% 0%,rgba(6,182,212,.13) 0%,transparent 70%); pointer-events:none; }
.stat-cell.c-amber::after  { content:''; position:absolute; inset:0; background:radial-gradient(ellipse at 50% 0%,rgba(245,158,11,.13) 0%,transparent 70%); pointer-events:none; }
.stat-cell.c-purple::after { content:''; position:absolute; inset:0; background:radial-gradient(ellipse at 50% 0%,rgba(139,92,246,.13) 0%,transparent 70%); pointer-events:none; }

.stat-cell .sc-label {
    font-size: .82rem; font-weight: 900; text-transform: uppercase;
    letter-spacing: .22em; color: #cbd5e1;
    margin-bottom: 1.2rem; text-align: right;
}
.stat-cell .sc-value {
    font-size: 2.8rem; font-weight: 900; line-height: 1;
    margin-bottom: .8rem; text-align: right;
    letter-spacing: -.02em;
}
.stat-cell .sc-sub   { font-size: .87rem; color: #94a3b8; text-align: right; font-weight: 600; }

/* Value colors — brighter, more saturated */
.stat-cell.c-blue   .sc-value { color: #3b82f6; text-shadow: 0 0 35px rgba(59,130,246,.8), 0 0 60px rgba(59,130,246,.5); }
.stat-cell.c-red    .sc-value { color: #f87171; text-shadow: 0 0 35px rgba(248,113,113,.8), 0 0 60px rgba(248,113,113,.5); }
.stat-cell.c-green  .sc-value { color: #10b981; text-shadow: 0 0 35px rgba(16,185,129,.8), 0 0 60px rgba(16,185,129,.5); }
.stat-cell.c-teal   .sc-value { color: #06b6d4; text-shadow: 0 0 35px rgba(6,182,212,.8), 0 0 60px rgba(6,182,212,.5); }
.stat-cell.c-amber  .sc-value { color: #f59e0b; text-shadow: 0 0 35px rgba(245,158,11,.8), 0 0 60px rgba(245,158,11,.5); }
.stat-cell.c-purple .sc-value { color: #a78bfa; text-shadow: 0 0 35px rgba(167,139,250,.8), 0 0 60px rgba(167,139,250,.5); }

/* ── CHART PANELS ── */
.chart-panel {
    background: linear-gradient(135deg, #162844 0%, #1e3a52 50%, #243558 100%);
    border: 3px solid rgba(59,130,246,.6);
    border-radius: 24px;
    padding: 2.75rem;
    transition: all .4s cubic-bezier(.34, 1.56, .64, 1);
    box-shadow: 0 16px 50px rgba(0,0,0,.6), 0 0 50px rgba(59,130,246,.3), inset 0 1px 15px rgba(255,255,255,.08);
}
.chart-panel canvas {
    background: #1e2d4a;
    border-radius: 10px;
}
.chart-panel.clickable { cursor: pointer; }
.chart-panel.clickable:hover {
    border-color: rgba(59,130,246,1);
    box-shadow: 0 24px 70px rgba(59,130,246,.5), 0 0 60px rgba(59,130,246,.4), inset 0 1px 20px rgba(255,255,255,.15);
    transform: translateY(-8px);
}

.cp-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 2.2rem;
}
.cp-title {
    font-size: 1.05rem; font-weight: 800; text-transform: uppercase;
    letter-spacing: .18em; color: #f1f5f9;
    display: flex; align-items: center; gap: 1rem;
}
.cp-title .dot {
    width: 14px; height: 14px; border-radius: 50%;
    box-shadow: 0 0 16px currentColor, 0 0 8px currentColor;
}
.cp-badge {
    font-size: .77rem; font-weight: 700; padding: .35rem 1rem;
    border-radius: 999px;
    background: rgba(99,102,241,.35); color: #e0e7ff;
    border: 2px solid rgba(99,102,241,.7);
    display: flex; align-items: center; gap: .5rem;
    text-shadow: 0 0 8px rgba(99,102,241,.5);
}

/* Layout grids */8rem; margin-bottom: 2.8rem; }
.grid-2    { display: grid; grid-template-columns: repeat(auto-fit, minmax(420px,1fr)); gap: 2.8rem; margin-bottom: 2.8rem; }
.grid-3    { display: grid; grid-template-columns: repeat(auto-fit, minmax(340px,1fr)); gap: 2.8rem; margin-bottom: 2.8rem; }
.grid-3    { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px,1fr)); gap: 2.2rem; margin-bottom: 2.2rem; }

/* ── SIDE PANEL DRILL-DOWN ── */
.drill-panel {
    position: fixed; top: 0; right: -520px; width: 500px; height: 100vh;
    background: #141e30;
    border-left: 2px solid rgba(255,255,255,.15);
    z-index: 900; transition: right .35s cubic-bezier(.4,0,.2,1);
    display: flex; flex-direction: column;
    box-shadow: -24px 0 80px rgba(0,0,0,.6);
}
.drill-panel.open { right: 0; }
.drill-panel-header {
    padding: 1.75rem;
    border-bottom: 1px solid rgba(255,255,255,.12);
    display: flex; align-items: center; justify-content: space-between;
    flex-shrink: 0;
}
.drill-panel-title { font-size: 1.1rem; font-weight: 700; color: #ffffff; }
.drill-panel-close {
    width: 36px; height: 36px; border-radius: 8px;
    background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.2);
    color: #d1d5db; cursor: pointer; font-size: .95rem;
    display: flex; align-items: center; justify-content: center;
    transition: all .2s;
}
.drill-panel-close:hover { background: rgba(239,68,68,.25); color: #fca5a5; border-color: rgba(239,68,68,.5); }
.drill-panel-body { flex: 1; overflow-y: auto; padding: 1.75rem; }
.drill-panel-body::-webkit-scrollbar { width: 5px; }
.drill-panel-body::-webkit-scrollbar-thumb { background: #374151; border-radius: 2px; }

/* Backdrop */
.drill-backdrop {
    position: fixed; inset: 0; background: rgba(0,0,0,.7);
    z-index: 899; opacity: 0; pointer-events: none;
    transition: opacity .35s ease;
}
.drill-backdrop.open { opacity: 1; pointer-events: all; }

/* Drill table */
.drill-tbl { width: 100%; border-collapse: collapse; font-size: .88rem; margin-top: 1.25rem; }
.drill-tbl thead th { padding: .75rem .85rem; text-align: left; font-size: .71rem; font-weight: 800; text-transform: uppercase; letter-spacing: .1em; color: #94a3b8; border-bottom: 1px solid rgba(255,255,255,.12); }
.drill-tbl tbody tr { border-bottom: 1px solid rgba(255,255,255,.07); transition: background .15s; }
.drill-tbl tbody tr:hover { background: rgba(255,255,255,.06); }
.drill-tbl tbody td { padding: .7rem .85rem; color: #e2e8f0; }

@@media (max-width: 768px) {
    .stat-strip { grid-template-columns: repeat(3,1fr); }
    .an-hero { grid-template-columns: 1fr; }
    .drill-panel { width: 100%; right: -100%; }
    .stat-cell .sc-value { font-size: 1.8rem; }
    .an-wrap { padding: 0 1rem 2rem; }
}
</style>
}

<div class="an-wrap">

<!-- ── HERO ── -->
<div class="an-hero">
    <div>
        <a href="javascript:history.back()" style="display:inline-flex;align-items:center;gap:.5rem;margin-bottom:1rem;padding:.45rem 1rem;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.2);border-radius:8px;color:#cbd5e1;font-size:.82rem;font-weight:600;text-decoration:none;transition:all .2s ease;">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
            Back
        </a>
        <div class="an-hero-eyebrow">Business Intelligence · Data Visualization</div>
        <h1>Analytics<br><span style="color:#818cf8;">Dashboard</span></h1>
        <p>@Model.DateFrom.ToString("MMM dd") &ndash; @Model.DateTo.ToString("MMM dd, yyyy") &nbsp;·&nbsp; Interactive drill-down enabled</p>
    </div>
    <div class="period-pills">
        @foreach (var p in new[] { ("7d","7D"), ("30d","30D"), ("90d","90D"), ("ytd","YTD") })
        {
            <a href="@Url.Action("Index","Analytics",new{period=p.Item1})"
               class="period-pill @(Model.Period==p.Item1?"active":"")">@p.Item2</a>
        }
    </div>
</div>

<!-- ── STAT STRIP ── -->
<div class="stat-strip">
    <div class="stat-cell c-blue">
        <div class="sc-label">Revenue</div>
        <div class="sc-value">₱@Model.TotalRevenue.ToString("N0")</div>
        <div class="sc-sub">Period total</div>
    </div>
    <div class="stat-cell c-red">
        <div class="sc-label">Expenses</div>
        <div class="sc-value">₱@Model.TotalExpenses.ToString("N0")</div>
        <div class="sc-sub">Period total</div>
    </div>
    <div class="stat-cell @(Model.NetProfit>=0?"c-green":"c-red")">
        <div class="sc-label">Net Profit</div>
        <div class="sc-value">₱@Model.NetProfit.ToString("N0")</div>
        <div class="sc-sub">@Model.GrossMargin.ToString("F1")% margin</div>
    </div>
    <div class="stat-cell c-teal">
        <div class="sc-label">Sales</div>
        <div class="sc-value">@Model.TotalSales</div>
        <div class="sc-sub">Avg ₱@Model.AvgOrderValue.ToString("N0")</div>
    </div>
    <div class="stat-cell c-amber">
        <div class="sc-label">Products</div>
        <div class="sc-value">@Model.TotalProducts</div>
        <div class="sc-sub">@Model.LowStockCount low stock</div>
    </div>
    <div class="stat-cell c-purple">
        <div class="sc-label">Gross Margin</div>
        <div class="sc-value">@Model.GrossMargin.ToString("F1")%</div>
        <div class="sc-sub">Efficiency</div>
    </div>
</div>

<!-- ── ROW 1: Trend + Monthly P&L ── -->
<div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem;">

    <div class="chart-panel clickable" onclick="drillTrend()">
        <div class="cp-header">
            <div class="cp-title"><span class="dot" style="color:#3b82f6;background:#3b82f6;"></span> Revenue vs Expenses — Daily Trend</div>
            <div class="cp-badge"><i class="bi bi-zoom-in"></i> Drill down</div>
        </div>
        <canvas id="trendChart" height="100"></canvas>
    </div>

    <div class="chart-panel clickable" id="monthlyPanel">
        <div class="cp-header">
            <div class="cp-title"><span class="dot" style="color:#10b981;background:#10b981;"></span> 6-Month P&amp;L Overview</div>
            <div class="cp-badge"><i class="bi bi-zoom-in"></i> Click bar</div>
        </div>
        <canvas id="monthlyChart" height="100"></canvas>
    </div>

</div>

<!-- ── ROW 2: Expense Breakdown + Top Products ── -->
<div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem;">

    <div class="chart-panel clickable" onclick="drillExpensePie()">
        <div class="cp-header">
            <div class="cp-title"><span class="dot" style="color:#ef4444;background:#ef4444;"></span> Expense Breakdown</div>
            <div class="cp-badge"><i class="bi bi-zoom-in"></i> Click slice</div>
        </div>
        <canvas id="expensePieChart" height="100"></canvas>
    </div>

    <div class="chart-panel clickable" id="topProductsPanel">
        <div class="cp-header">
            <div class="cp-title"><span class="dot" style="color:#f59e0b;background:#f59e0b;"></span> Top Products by Sales Volume</div>
            <div class="cp-badge"><i class="bi bi-zoom-in"></i> Click bar</div>
        </div>
        <canvas id="topProductsChart" height="100"></canvas>
    </div>

</div>

<!-- ── ROW 3: Revenue by Category + Stock Levels ── -->
<div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem;">

    <div class="chart-panel clickable" onclick="drillRevenuePie()">
        <div class="cp-header">
            <div class="cp-title"><span class="dot" style="color:#6366f1;background:#6366f1;"></span> Revenue by Category</div>
            <div class="cp-badge"><i class="bi bi-zoom-in"></i> Click slice</div>
        </div>
        <canvas id="revenuePieChart" height="100"></canvas>
    </div>

    <div class="chart-panel">
        <div class="cp-header">
            <div class="cp-title"><span class="dot" style="color:#8b5cf6;background:#8b5cf6;"></span> Inventory Stock Levels</div>
            <div class="cp-badge" style="background:rgba(239,68,68,.2);color:#fca5a5;border-color:rgba(239,68,68,.4);"><i class="bi bi-exclamation-triangle"></i> Red = below reorder</div>
        </div>
        <canvas id="stockChart" height="100"></canvas>
    </div>

</div>

<!-- ── ROW 4: Heat Map + Forecast Accuracy ── -->
<div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem;">

    <div class="chart-panel">
        <div class="cp-header">
            <div class="cp-title"><span class="dot" style="color:#06b6d4;background:#06b6d4;"></span> Sales Heat Map (Hour × Day)</div>
            <div class="cp-badge" style="background:rgba(6,182,212,.2);color:#22d3ee;border-color:rgba(6,182,212,.4);">Activity density</div>
        </div>
        <canvas id="heatChart" height="100"></canvas>
    </div>

    <div class="chart-panel">
        <div class="cp-header">
            <div class="cp-title"><span class="dot" style="color:#f59e0b;background:#f59e0b;"></span> Forecast Accuracy Benchmarker</div>
            <div class="cp-badge" id="accuracyBadge" style="background:rgba(245,158,11,.2);color:#fbbf24;border-color:rgba(245,158,11,.4);">Loading…</div>
        </div>
        <canvas id="forecastAccChart" height="100"></canvas>
    </div>

</div>

<!-- ── STOCK DEMAND PREDICTOR ── -->
<div class="grid-main" style="margin-bottom:0;">
    <div class="chart-panel">
        <div class="cp-header">
            <div class="cp-title"><span class="dot" style="color:#10b981;background:#10b981;"></span> Stock Velocity &amp; Demand Predictor</div>
            <div class="cp-badge" style="background:rgba(239,68,68,.2);color:#fca5a5;border-color:rgba(239,68,68,.4);"><i class="bi bi-exclamation-triangle"></i> Red = &lt;3 days left</div>
        </div>
        <div id="demandTable" style="overflow-x:auto;border-radius:10px;border:1px solid rgba(255,255,255,.1);">
            <table style="width:100%;border-collapse:collapse;font-size:.88rem;">
                <thead><tr style="background:#0d1626;">
                    <th style="padding:1rem;text-align:left;font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.11em;color:#94a3b8;border-bottom:1px solid rgba(255,255,255,.1);">Product</th>
                    <th style="padding:1rem;text-align:right;font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.11em;color:#94a3b8;border-bottom:1px solid rgba(255,255,255,.1);">Daily Avg</th>
                    <th style="padding:1rem;text-align:right;font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.11em;color:#94a3b8;border-bottom:1px solid rgba(255,255,255,.1);">Stock</th>
                    <th style="padding:1rem;text-align:right;font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.11em;color:#94a3b8;border-bottom:1px solid rgba(255,255,255,.1);">Days Left</th>
                    <th style="padding:1rem;text-align:left;font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.11em;color:#94a3b8;border-bottom:1px solid rgba(255,255,255,.1);">Status</th>
                </tr></thead>
                <tbody id="demandBody"><tr><td colspan="5" style="padding:2.5rem;text-align:center;color:#64748b;">Loading…</td></tr></tbody>
            </table>
        </div>
    </div>
</div>

</div><!-- /an-wrap -->

<!-- ── DRILL BACKDROP ── -->
<div class="drill-backdrop" id="drillBackdrop" onclick="closeDrill()"></div>

<!-- ── DRILL SIDE PANEL ── -->
<div class="drill-panel" id="drillPanel">
    <div class="drill-panel-header">
        <span class="drill-panel-title" id="drillTitle">Loading…</span>
        <button class="drill-panel-close" onclick="closeDrill()">✕</button>
    </div>
    <div class="drill-panel-body">
        <canvas id="drillChart" height="180" style="margin-bottom:1.75rem;"></canvas>
        <div id="drillTableWrap" style="display:none;">
            <p style="font-size:.73rem;font-weight:800;text-transform:uppercase;letter-spacing:.13em;color:#94a3b8;margin:0 0 1rem;">Transaction Detail</p>
            <div style="border-radius:10px;border:1px solid rgba(255,255,255,.08);overflow:hidden;">
                <table class="drill-tbl">
                    <thead><tr><th>Date</th><th>Description</th><th>Category</th><th>Amount</th></tr></thead>
                    <tbody id="drillTableBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
// Mark body so dashboard.css analytics overrides apply
document.body.classList.add('analytics-page');

// ── Global defaults — brighter, higher contrast
Chart.defaults.color = '#e2e8f0';
Chart.defaults.borderColor = 'rgba(255,255,255,.15)';
Chart.defaults.font.family = "-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif";
Chart.defaults.font.size = 13;

// ── Force every chart canvas to have a solid visible background
const canvasBgPlugin = {
    id: 'canvasBg',
    beforeDraw(chart) {
        const ctx = chart.canvas.getContext('2d');
        ctx.save();
        ctx.globalCompositeOperation = 'destination-over';
        ctx.fillStyle = '#162844';
        ctx.fillRect(0, 0, chart.width, chart.height);
        ctx.restore();
    }
};
