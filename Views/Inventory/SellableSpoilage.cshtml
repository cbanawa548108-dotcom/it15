@{
    ViewData["Title"] = "Sellable Spoilage";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var sellable = ViewBag.SellableItems as List<CRLFruitstandESS.Models.SpoilageRecord> ?? new();
    var sold     = ViewBag.SoldItems     as List<CRLFruitstandESS.Models.SpoilageRecord> ?? new();
}

@section Styles {
<style>
.page-content{background:#0f172a!important;min-height:100vh}
.sp-header{background:linear-gradient(135deg,#1e293b,#0f172a);border:1px solid #334155;border-radius:14px;padding:2rem;margin-bottom:1.5rem}
.dark-card{background:#1e293b;border:1px solid #334155;border-radius:14px;padding:1.75rem;margin-bottom:1.5rem}
.section-title{font-size:1rem;font-weight:700;color:#f1f5f9;display:flex;align-items:center;gap:.6rem;margin:0 0 1.25rem}
.stat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:1rem;margin-bottom:1.5rem}
.stat-box{background:#0f172a;border:1px solid #334155;border-radius:10px;padding:1rem 1.25rem;text-align:right}
.stat-label{font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.09em;color:#475569;margin-bottom:.3rem}
.stat-value{font-size:1.6rem;font-weight:800}
.sell-card{background:#0f172a;border:1px solid #334155;border-radius:10px;padding:1.25rem;margin-bottom:.75rem;transition:border-color .2s}
.sell-card:hover{border-color:#475569}
.form-dark{background:#1e293b;border:1px solid #334155;border-radius:8px;padding:.6rem .875rem;color:#f1f5f9;font-size:.875rem;outline:none;transition:border-color .2s}
.form-dark:focus{border-color:#10b981}
.btn-sell{padding:.5rem 1.25rem;background:#10b981;color:white;border:none;border-radius:8px;font-weight:700;cursor:pointer;font-size:.875rem;transition:background .2s}
.btn-sell:hover{background:#059669}
.sp-table{width:100%;border-collapse:collapse;font-size:.875rem}
.sp-table thead th{padding:.75rem 1rem;text-align:left;font-size:.7rem;font-weight:700;text-transform:uppercase;color:#475569;border-bottom:1px solid #334155;background:#0f172a}
.sp-table tbody tr{border-bottom:1px solid #1e293b}
.sp-table tbody tr:hover{background:#0f172a}
.sp-table tbody td{padding:.7rem 1rem;color:#cbd5e1}
.badge-type{display:inline-block;padding:.2rem .6rem;border-radius:999px;font-size:.65rem;font-weight:700;text-transform:uppercase}
</style>
}

<div class="sp-header">
    <span style="font-size:.7rem;font-weight:800;text-transform:uppercase;letter-spacing:.12em;color:#10b981;display:block;margin-bottom:.4rem;">Inventory · Spoilage</span>
    <h1 style="font-size:2rem;font-weight:800;color:#f1f5f9;margin:0 0 .4rem;">🏷️ Sellable Spoilage</h1>
    <p style="color:#94a3b8;margin:0;">Degraded but still sellable items — sell at a discount to recover partial value.</p>
</div>

@if (TempData["Success"] != null)
{
    <div style="padding:1rem 1.5rem;background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.3);border-radius:10px;color:#34d399;margin-bottom:1.5rem;">
        <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div style="padding:1rem 1.5rem;background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);border-radius:10px;color:#fca5a5;margin-bottom:1.5rem;">
        <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
    </div>
}

<div class="stat-grid">
    <div class="stat-box" style="border-top:3px solid #f59e0b">
        <div class="stat-label">Available Items</div>
        <div class="stat-value" style="color:#fbbf24">@sellable.Count</div>
        <div style="font-size:.72rem;color:#475569">product lines</div>
    </div>
    <div class="stat-box" style="border-top:3px solid #10b981">
        <div class="stat-label">Total Units</div>
        <div class="stat-value" style="color:#34d399">@ViewBag.TotalAvailable</div>
        <div style="font-size:.72rem;color:#475569">units available</div>
    </div>
    <div class="stat-box" style="border-top:3px solid #3b82f6">
        <div class="stat-label">Potential Revenue</div>
        <div class="stat-value" style="color:#60a5fa;font-size:1.3rem">₱@(((decimal)ViewBag.PotentialRevenue).ToString("N0"))</div>
        <div style="font-size:.72rem;color:#475569">at discounted price</div>
    </div>
    <div class="stat-box" style="border-top:3px solid #8b5cf6">
        <div class="stat-label">Revenue Recovered</div>
        <div class="stat-value" style="color:#a78bfa;font-size:1.3rem">₱@(((decimal)ViewBag.TotalSoldRevenue).ToString("N0"))</div>
        <div style="font-size:.72rem;color:#475569">from sold spoilage</div>
    </div>
</div>

<!-- Available to sell -->
<div class="dark-card">
    <p class="section-title">
        <i class="bi bi-tag-fill" style="color:#f59e0b"></i> Available for Discounted Sale
    </p>
    @if (!sellable.Any())
    {
        <div style="text-align:center;padding:2.5rem;color:#475569">
            <div style="font-size:2rem;margin-bottom:.5rem">🎉</div>
            No sellable spoilage items at the moment.
            <br/><a href="/Inventory/RecordSpoilage" style="color:#3b82f6;font-size:.875rem;">Record spoilage as sellable →</a>
        </div>
    }
    else
    {
        @foreach (var item in sellable)
        {
            <div class="sell-card">
                <div style="display:flex;align-items:start;justify-content:space-between;gap:1rem;flex-wrap:wrap;">
                    <div style="flex:1">
                        <div style="display:flex;align-items:center;gap:.75rem;margin-bottom:.4rem;flex-wrap:wrap;">
                            <span style="font-size:1.5rem">@item.Product?.Emoji</span>
                            <strong style="color:#f1f5f9;font-size:.95rem">@item.Product?.Name</strong>
                            <span class="badge-type" style="background:rgba(245,158,11,.15);color:#fbbf24;border:1px solid rgba(245,158,11,.3)">@item.Reason</span>
                            <span class="badge-type" style="background:rgba(99,102,241,.15);color:#a5b4fc;border:1px solid rgba(99,102,241,.3)">@item.SpoilageType</span>
                        </div>
                        <div style="display:flex;gap:1.5rem;flex-wrap:wrap;font-size:.82rem;color:#64748b;">
                            <span>📦 <strong style="color:#94a3b8">@item.Quantity</strong> units available</span>
                            <span>💰 Suggested: <strong style="color:#34d399">₱@item.DiscountedPrice.ToString("N2")</strong>/unit</span>
                            <span>📅 Recorded: @item.RecordedAt.ToString("MMM dd, yyyy")</span>
                        </div>
                        @if (!string.IsNullOrEmpty(item.Notes))
                        {
                            <p style="color:#475569;font-size:.78rem;margin:.4rem 0 0">@item.Notes</p>
                        }
                    </div>
                    <form method="post" action="/Inventory/SellSpoilage" style="display:flex;flex-direction:column;gap:.5rem;min-width:240px;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="spoilageId" value="@item.Id" />
                        <input type="hidden" name="paymentMethod" class="payment-method-input" value="cash" />
                        <div style="display:flex;gap:.5rem;">
                            <input type="number" name="quantityToSell" class="form-dark" style="width:80px"
                                   min="1" max="@item.Quantity" value="@item.Quantity" placeholder="Qty" required />
                            <input type="number" name="salePrice" class="form-dark" style="width:100px"
                                   min="0.01" step="0.01" value="@item.DiscountedPrice" placeholder="₱/unit" required />
                        </div>
                        <!-- Payment method selector -->
                        <div style="display:flex;gap:.4rem;" class="pay-method-group">
                            <button type="button" class="pay-btn active" data-method="cash"
                                    style="flex:1;padding:.4rem .5rem;border-radius:7px;border:1px solid #10b981;background:rgba(16,185,129,.15);color:#34d399;font-size:.75rem;font-weight:700;cursor:pointer;transition:all .2s">
                                💵 Cash
                            </button>
                            <button type="button" class="pay-btn" data-method="gcash"
                                    style="flex:1;padding:.4rem .5rem;border-radius:7px;border:1px solid #334155;background:#0f172a;color:#94a3b8;font-size:.75rem;font-weight:700;cursor:pointer;transition:all .2s">
                                📱 GCash
                            </button>
                            <button type="button" class="pay-btn" data-method="paymaya"
                                    style="flex:1;padding:.4rem .5rem;border-radius:7px;border:1px solid #334155;background:#0f172a;color:#94a3b8;font-size:.75rem;font-weight:700;cursor:pointer;transition:all .2s">
                                💳 Maya
                            </button>
                        </div>
                        <button type="submit" class="btn-sell" style="width:100%">
                            <i class="bi bi-cart-check-fill"></i> Sell Spoilage
                        </button>
                    </form>
                </div>
            </div>
        }
    }
</div>

<!-- Sold history -->
@if (sold.Any())
{
    <div class="dark-card">
        <p class="section-title">
            <i class="bi bi-receipt" style="color:#8b5cf6"></i> Recent Sell Spoilage Transactions
        </p>
        <div style="overflow-x:auto;border-radius:8px;border:1px solid #334155">
            <table class="sp-table">
                <thead>
                    <tr><th>Date Sold</th><th>Product</th><th>Qty Sold</th><th>Sale Price</th><th>Revenue</th><th>Payment</th><th>Type</th></tr>
                </thead>
                <tbody>
                    @foreach (var s in sold)
                    {
                        <tr>
                            <td style="color:#64748b;font-size:.8rem">@s.SoldAt?.ToString("MMM dd, yyyy HH:mm")</td>
                            <td style="font-weight:600;color:#f1f5f9">@s.Product?.Emoji @s.Product?.Name</td>
                            <td style="color:#fbbf24">@s.SoldQuantity</td>
                            <td style="color:#94a3b8">₱@(s.SoldQuantity > 0 ? (s.SoldRevenue / s.SoldQuantity).ToString("N2") : "0.00")/unit</td>
                            <td style="color:#34d399;font-weight:700">₱@s.SoldRevenue.ToString("N2")</td>
                            <td>
                                @{
                                    var pm = s.PaymentMethod?.ToLower() ?? "cash";
                                    var (pmIcon, pmColor, pmBg) = pm switch {
                                        "gcash"   => ("📱 GCash",  "#60a5fa", "rgba(59,130,246,.15)"),
                                        "paymaya" => ("💳 Maya",   "#a78bfa", "rgba(139,92,246,.15)"),
                                        _         => ("💵 Cash",   "#34d399", "rgba(16,185,129,.15)")
                                    };
                                }
                                <span class="badge-type" style="background:@pmBg;color:@pmColor;border:1px solid @pmColor">@pmIcon</span>
                            </td>
                            <td><span class="badge-type" style="background:rgba(99,102,241,.15);color:#a5b4fc;border:1px solid rgba(99,102,241,.3)">@s.SpoilageType</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
<script>
// Payment method toggle for each sell card
document.querySelectorAll('.pay-method-group').forEach(function(group) {
    var form   = group.closest('form');
    var hidden = form.querySelector('.payment-method-input');

    group.querySelectorAll('.pay-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            // Update hidden input
            hidden.value = btn.dataset.method;

            // Reset all buttons in this group
            group.querySelectorAll('.pay-btn').forEach(function(b) {
                b.style.borderColor = '#334155';
                b.style.background  = '#0f172a';
                b.style.color       = '#94a3b8';
            });

            // Highlight selected
            var colors = {
                cash:    { border: '#10b981', bg: 'rgba(16,185,129,.15)', color: '#34d399' },
                gcash:   { border: '#3b82f6', bg: 'rgba(59,130,246,.15)', color: '#60a5fa' },
                paymaya: { border: '#8b5cf6', bg: 'rgba(139,92,246,.15)', color: '#a78bfa' }
            };
            var c = colors[btn.dataset.method] || colors.cash;
            btn.style.borderColor = c.border;
            btn.style.background  = c.bg;
            btn.style.color       = c.color;

            // Update submit button label for digital payments
            var submitBtn = form.querySelector('button[type="submit"]');
            if (btn.dataset.method === 'gcash') {
                submitBtn.innerHTML = '<i class="bi bi-phone-fill"></i> Pay via GCash';
            } else if (btn.dataset.method === 'paymaya') {
                submitBtn.innerHTML = '<i class="bi bi-credit-card-fill"></i> Pay via Maya';
            } else {
                submitBtn.innerHTML = '<i class="bi bi-cart-check-fill"></i> Sell Spoilage';
            }
        });
    });
});
</script>
}
