@{
    ViewData["Title"] = "AI Spoilage Prediction";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var predictions = ViewBag.Predictions as List<object> ?? new();
}

@section Styles {
<style>
.page-content{background:#0f172a!important;min-height:100vh}
.sp-header{background:linear-gradient(135deg,#1e293b,#0f172a);border:1px solid #334155;border-radius:14px;padding:2rem;margin-bottom:1.5rem}
.dark-card{background:#1e293b;border:1px solid #334155;border-radius:14px;padding:1.75rem;margin-bottom:1.5rem}
.section-title{font-size:1rem;font-weight:700;color:#f1f5f9;display:flex;align-items:center;gap:.6rem;margin:0 0 1.25rem}
.stat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:1rem;margin-bottom:1.5rem}
.stat-box{background:#0f172a;border:1px solid #334155;border-radius:10px;padding:1rem 1.25rem;text-align:right}
.stat-label{font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.09em;color:#475569;margin-bottom:.3rem}
.stat-value{font-size:1.6rem;font-weight:800}
.pred-card{background:#0f172a;border:1px solid #334155;border-radius:12px;padding:1.25rem;margin-bottom:.875rem;transition:border-color .2s}
.pred-card:hover{border-color:#475569}
.risk-bar-track{background:#1e293b;border-radius:4px;height:8px;overflow:hidden;margin:.4rem 0 .25rem}
.risk-bar-fill{height:100%;border-radius:4px;transition:width .6s ease}
.form-dark{background:#1e293b;border:1px solid #334155;border-radius:8px;padding:.6rem .875rem;color:#f1f5f9;font-size:.875rem;outline:none;transition:border-color .2s;width:100%;box-sizing:border-box}
.form-dark:focus{border-color:#f59e0b}
.btn-confirm{padding:.6rem 1.25rem;background:#f59e0b;color:#0d1526;border:none;border-radius:8px;font-weight:700;cursor:pointer;font-size:.85rem;transition:background .2s;width:100%}
.btn-confirm:hover{background:#d97706}
.formula-box{background:#0d1526;border:1px solid #1e3a5f;border-radius:10px;padding:1rem 1.25rem}
</style>
}

<div class="sp-header">
    <span style="font-size:.7rem;font-weight:800;text-transform:uppercase;letter-spacing:.12em;color:#f59e0b;display:block;margin-bottom:.4rem;">Inventory · AI Prediction</span>
    <h1 style="font-size:2rem;font-weight:800;color:#f1f5f9;margin:0 0 .5rem;">🤖 AI Spoilage Prediction</h1>
    <p style="color:#94a3b8;margin:0;">The system analyzes how long each product has been in stock and predicts how much is likely to spoil — based on CRL Fruitstand's 5-year spoilage data.</p>
</div>

@if (TempData["Success"] != null)
{
    <div style="padding:1rem 1.5rem;background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.3);border-radius:10px;color:#34d399;margin-bottom:1.5rem;">
        <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
    </div>
}

<!-- How it works -->
<div class="dark-card" style="border-left:4px solid #f59e0b;">
    <p class="section-title" style="margin-bottom:.75rem;">
        <i class="bi bi-mortarboard-fill" style="color:#f59e0b;"></i> How the AI Prediction Works
    </p>
    <p style="color:#94a3b8;font-size:.875rem;margin:0 0 1rem;line-height:1.7;">
        Fruit spoils faster as it ages. The system checks how many days each product has been sitting in stock since the last delivery,
        then estimates how much of it is likely to have spoiled using the <strong style="color:#f1f5f9;">30.5% spoilage benchmark</strong>
        from CRL Fruitstand's actual 5-year sales data (2020–2024).
    </p>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1rem;margin-bottom:1rem;">
        <div class="formula-box">
            <div style="font-size:.7rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:#f59e0b;margin-bottom:.5rem;">① Spoilage Risk %</div>
            <div style="font-family:monospace;font-size:.9rem;color:#f1f5f9;background:#060d1a;padding:.5rem .75rem;border-radius:6px;margin-bottom:.4rem;">
                Risk = Days Since Last Stock-In ÷ 7
            </div>
            <p style="font-size:.75rem;color:#64748b;margin:0;line-height:1.5;">
                Fruit typically lasts 5–7 days. After 7 days, risk = 100%. After 3.5 days, risk = 50%.
                Capped at 100% maximum.
            </p>
        </div>
        <div class="formula-box">
            <div style="font-size:.7rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:#ef4444;margin-bottom:.5rem;">② Predicted Spoilage Units</div>
            <div style="font-family:monospace;font-size:.9rem;color:#f1f5f9;background:#060d1a;padding:.5rem .75rem;border-radius:6px;margin-bottom:.4rem;">
                Units = Stock × 30.5% × Risk
            </div>
            <p style="font-size:.75rem;color:#64748b;margin:0;line-height:1.5;">
                30.5% is the average spoilage rate from 5 years of CRL Fruitstand data.
                Multiplied by the age-based risk to get the predicted spoiled quantity.
            </p>
        </div>
        <div class="formula-box">
            <div style="font-size:.7rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:#fbbf24;margin-bottom:.5rem;">③ Estimated Loss (₱)</div>
            <div style="font-family:monospace;font-size:.9rem;color:#f1f5f9;background:#060d1a;padding:.5rem .75rem;border-radius:6px;margin-bottom:.4rem;">
                Loss = Predicted Units × Cost Price
            </div>
            <p style="font-size:.75rem;color:#64748b;margin:0;line-height:1.5;">
                The financial impact if the predicted spoilage is not addressed.
                Based on the product's purchase cost, not selling price.
            </p>
        </div>
    </div>
    <div style="display:flex;gap:1rem;flex-wrap:wrap;font-size:.8rem;">
        <span style="padding:.3rem .75rem;border-radius:20px;background:rgba(239,68,68,.15);color:#fca5a5;border:1px solid rgba(239,68,68,.3);">🔴 High Risk = 70–100% (stock is 5–7+ days old)</span>
        <span style="padding:.3rem .75rem;border-radius:20px;background:rgba(245,158,11,.15);color:#fbbf24;border:1px solid rgba(245,158,11,.3);">🟡 Medium Risk = 40–70% (stock is 3–5 days old)</span>
        <span style="padding:.3rem .75rem;border-radius:20px;background:rgba(34,197,94,.15);color:#34d399;border:1px solid rgba(34,197,94,.3);">🟢 Low Risk = 0–40% (stock is fresh, under 3 days)</span>
    </div>
</div>

<!-- Summary stats -->
<div class="stat-grid">
    <div class="stat-box" style="border-top:3px solid #ef4444">
        <div class="stat-label">High Risk Products</div>
        <div class="stat-value" style="color:#fca5a5">@ViewBag.HighRiskCount</div>
        <div style="font-size:.72rem;color:#475569">need immediate action</div>
    </div>
    <div class="stat-box" style="border-top:3px solid #f59e0b">
        <div class="stat-label">Total Units at Risk</div>
        <div class="stat-value" style="color:#fbbf24">@ViewBag.TotalAtRisk</div>
        <div style="font-size:.72rem;color:#475569">predicted to spoil</div>
    </div>
    <div class="stat-box" style="border-top:3px solid #6366f1">
        <div class="stat-label">Potential Loss</div>
        <div class="stat-value" style="color:#a5b4fc;font-size:1.3rem">₱@((decimal)ViewBag.TotalLossRisk).ToString("N0")</div>
        <div style="font-size:.72rem;color:#475569">if not addressed</div>
    </div>
</div>

<!-- Predictions list -->
<div class="dark-card">
    <p class="section-title">
        <i class="bi bi-list-check" style="color:#f59e0b"></i>
        Predictions by Product
        <span style="margin-left:auto;font-size:.72rem;font-weight:400;color:#475569">Sorted by highest risk first</span>
    </p>

    @if (!predictions.Any())
    {
        <div style="text-align:center;padding:2.5rem;color:#475569">
            <div style="font-size:2.5rem;margin-bottom:.75rem">✅</div>
            <strong style="color:#64748b;display:block;margin-bottom:.4rem;">All products are within safe range</strong>
            <span style="font-size:.85rem;">No spoilage predicted at this time. Check back after products have been in stock for a few days.</span>
        </div>
    }
    else
    {
        @foreach (dynamic pred in predictions)
        {
            string riskColor = pred.RiskColor;
            string riskLevel = pred.RiskLevel;
            double riskPct   = pred.SpoilageRisk;
            int    days      = pred.DaysSinceStockIn;
            int    predicted = pred.PredictedSpoilage;
            int    stock     = pred.CurrentStock;
            decimal loss     = pred.EstimatedLoss;

            <div class="pred-card" style="border-left:4px solid @riskColor">
                <div style="display:flex;align-items:start;justify-content:space-between;gap:1.5rem;flex-wrap:wrap;">

                    <!-- Left: product info + explanation -->
                    <div style="flex:1;min-width:220px;">
                        <div style="display:flex;align-items:center;gap:.75rem;margin-bottom:.6rem;flex-wrap:wrap;">
                            <span style="font-size:1.75rem;line-height:1;">@pred.Emoji</span>
                            <div>
                                <div style="font-weight:700;color:#f1f5f9;font-size:.95rem;">@pred.ProductName</div>
                                <div style="font-size:.75rem;color:#64748b;">@stock units in stock · last stocked @days day@(days == 1 ? "" : "s") ago</div>
                            </div>
                            <span style="padding:.25rem .75rem;border-radius:999px;font-size:.7rem;font-weight:700;
                                         background:@riskColor + "22";color:@riskColor;border:1px solid @riskColor + "44";">
                                @riskLevel Risk
                            </span>
                        </div>

                        <!-- Risk bar -->
                        <div style="margin-bottom:.75rem;">
                            <div style="display:flex;justify-content:space-between;font-size:.72rem;color:#475569;margin-bottom:.25rem;">
                                <span>Spoilage risk</span>
                                <span style="color:@riskColor;font-weight:700;">@riskPct%</span>
                            </div>
                            <div class="risk-bar-track">
                                <div class="risk-bar-fill" style="width:@riskPct%;background:@riskColor;"></div>
                            </div>
                        </div>

                        <!-- Plain-English explanation -->
                        <div style="background:#0d1526;border:1px solid #1e293b;border-radius:8px;padding:.75rem 1rem;font-size:.8rem;color:#64748b;line-height:1.6;">
                            <strong style="color:#94a3b8;">What this means:</strong>
                            This product has been in stock for <strong style="color:#f1f5f9;">@days days</strong>.
                            Based on the 30.5% spoilage rate and stock age,
                            approximately <strong style="color:@riskColor;">@predicted units</strong> out of @stock
                            are predicted to spoil — an estimated loss of
                            <strong style="color:#fbbf24;">₱@loss.ToString("N0")</strong>.
                            @if (riskLevel == "High")
                            {
                                <text> <strong style="color:#fca5a5;">Immediate action recommended.</strong></text>
                            }
                            else if (riskLevel == "Medium")
                            {
                                <text> Consider selling or discounting soon.</text>
                            }
                            else
                            {
                                <text> Stock is still fresh — monitor over the next few days.</text>
                            }
                        </div>
                    </div>

                    <!-- Right: confirm form -->
                    <form method="post" action="/Inventory/ConfirmPredictedSpoilage" style="min-width:220px;max-width:240px;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@pred.ProductId" />
                        <div style="font-size:.72rem;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.75rem;">
                            Confirm & Record
                        </div>
                        <div style="margin-bottom:.6rem;">
                            <label style="font-size:.75rem;color:#94a3b8;display:block;margin-bottom:.25rem;">
                                Quantity to write off
                                <span style="color:#475569;">(predicted: @predicted)</span>
                            </label>
                            <input type="number" name="quantity" class="form-dark" min="1" max="@stock" value="@predicted" required />
                        </div>
                        <div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.6rem;padding:.6rem;background:#0d1526;border-radius:8px;border:1px solid #1e293b;">
                            <input type="checkbox" name="isSellable" id="sell_@pred.ProductId" value="true"
                                   style="width:16px;height:16px;accent-color:#10b981;cursor:pointer;" />
                            <label for="sell_@pred.ProductId" style="font-size:.8rem;color:#34d399;cursor:pointer;font-weight:600;">
                                🏷️ Still sellable at discount
                            </label>
                        </div>
                        <div id="priceWrap_@pred.ProductId" style="display:none;margin-bottom:.6rem;">
                            <label style="font-size:.75rem;color:#94a3b8;display:block;margin-bottom:.25rem;">Discounted price (₱/unit)</label>
                            <input type="number" name="discountedPrice" class="form-dark" min="0.01" step="0.01" placeholder="e.g. 15.00" />
                        </div>
                        <button type="submit" class="btn-confirm">
                            <i class="bi bi-check2-circle"></i> Confirm Spoilage
                        </button>
                    </form>
                </div>
            </div>
        }
    }
</div>

@section Scripts {
<script>
document.querySelectorAll('[id^="sell_"]').forEach(function(cb) {
    cb.addEventListener('change', function() {
        var id = this.id.replace('sell_', '');
        var wrap = document.getElementById('priceWrap_' + id);
        if (wrap) wrap.style.display = this.checked ? 'block' : 'none';
    });
});
</script>
}
